{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "rewrites": [
      {
         "source": "/(.*)",
         "destination": "/index.html"
      }
   ],
   "headers": [
      {
         "source": "/(.*)\\.ics",
         "headers": [
            {
               "key": "Content-Type",
               "value": "text/calendar; charset=utf-8"
            }
         ]
      }
   ]
}
